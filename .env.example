# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Apple ID used for notarization (crates/oxcrypt-fileprovider/extension/notarize.sh)
APPLE_ID=
# Apple Developer Team ID
APPLE_TEAM_ID=
# App-specific password generated at appleid.apple.com (Sign-In and Security > App-Specific Passwords)
APPLE_APP_PASSWORD=
